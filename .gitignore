# Gizli bilgiler (NCBI anahtarı); şablonu .env.example
.env

# Python sanal ortamı ve önbelleği
.venv/
__pycache__/

# VS Code çalışma alanı ayarları (ayar değiştirilince oluşur)
.vscode/

# İndirilen gen listesi (m02 ilk çalıştırmada yeniden oluşturur)
genler.txt

# e02'nin eski doğru cevap listesi yedekleri; git geçmişi asıl kayıttır
evaluation/results/yedek/

# Model dosyaları (GGUF ~4,7 GB, LoRA adaptörü); repoya yalnız Ollama ayar dosyası (Modelfile) girer.
# *.gguf: model dosyası yanlışlıkla başka klasöre indirilirse de repoya girmesin (GitHub 100 MB sınırı)
models/*
!models/Modelfile.*
*.gguf
